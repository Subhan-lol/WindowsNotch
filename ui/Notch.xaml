<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:NotchIsland;assembly=NotchIsland"
      TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
      TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource Fg}">

  <!-- Near-invisible pad around the notch: makes hovering / dropping a bit forgiving -->
  <Border x:Name="HoverZone" HorizontalAlignment="Center" VerticalAlignment="Top"
          Background="#01000000" Padding="14,0,14,10" AllowDrop="True">
    <Grid x:Name="NotchRoot">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/>
      </Grid.ColumnDefinitions>
      <Path Grid.Column="0" VerticalAlignment="Top" Fill="Black" Data="M0,0 L12,0 L12,12 C12,5.4 6.6,0 0,0 Z"/>
      <Path Grid.Column="2" VerticalAlignment="Top" Fill="Black" Data="M12,0 L0,0 L0,12 C0,5.4 5.4,0 12,0 Z"/>

      <local:NotchBody x:Name="Body" Grid.Column="1" Background="Black" Width="180" Height="32" Radius="14"
                       BorderThickness="0" VerticalAlignment="Top">
        <Grid ClipToBounds="True">

          <!-- ===== Compact (collapsed) live activity ===== -->
          <Grid x:Name="Compact" Height="32" VerticalAlignment="Top" Margin="9,0,11,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="CLeft" VerticalAlignment="Center">
              <Border x:Name="CArt" Width="22" Height="22" CornerRadius="6" Visibility="Collapsed">
                <Border.Background><ImageBrush x:Name="CArtBrush" Stretch="UniformToFill"/></Border.Background>
              </Border>
              <TextBlock x:Name="CIcon" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Grid x:Name="CRing" Width="19" Height="19" Visibility="Collapsed">
                <Ellipse Stroke="#33FFFFFF" StrokeThickness="2.4"/>
                <Ellipse x:Name="CRingArc" Stroke="{DynamicResource Accent}" StrokeThickness="2.4" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </Grid>
            <Grid Grid.Column="1">
              <local:Mascot x:Name="MiniMascot" Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/>
              <StackPanel x:Name="CText" VerticalAlignment="Center" Margin="9,0,8,0" Visibility="Collapsed">
                <TextBlock x:Name="CTitle" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CSub" FontSize="10" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="CRight" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel x:Name="CEq" Orientation="Horizontal" Height="16" Visibility="Collapsed" VerticalAlignment="Center">
                <Rectangle x:Name="Bar0" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar1" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
                <Rectangle x:Name="Bar3" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.2"/></Rectangle.RenderTransform></Rectangle>
              </StackPanel>
              <Grid x:Name="CBar" Width="96" Height="5" VerticalAlignment="Center" Visibility="Collapsed">
                <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                <Border x:Name="CBarFill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="40"/>
              </Grid>
              <TextBlock x:Name="CRightText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Grid>

          <!-- ===== Delivery card (files arriving from the iPhone) ===== -->
          <Grid x:Name="DeliveryCard" Width="400" Height="92" VerticalAlignment="Top" HorizontalAlignment="Center"
                Visibility="Collapsed" Opacity="0" Cursor="Hand" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
            <local:Mascot x:Name="DeliveryMascot" Width="70" Height="70" Margin="14,14,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <TextBlock x:Name="DelParcelIcon" Text="&#xE7B8;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="#D9A066"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,8,0,0" Visibility="Collapsed"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,8,8,0">
              <TextBlock x:Name="DelTitle" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="DelName" FontSize="11.5" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              <Grid x:Name="DelTrack" Height="5" Margin="0,8,0,0">
                <Border CornerRadius="2.5" Background="#2EFFFFFF"/>
                <Border x:Name="DelFill" CornerRadius="2.5" HorizontalAlignment="Left" Width="0" Background="{DynamicResource Accent}"/>
              </Grid>
              <TextBlock x:Name="DelMeta" FontSize="10.5" Foreground="{StaticResource FgFaint}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
            </StackPanel>
            <Grid Grid.Column="2" Width="48" Height="48" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,10,0" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform x:Name="DelSlotScale"/></Grid.RenderTransform>
              <Border CornerRadius="13" Background="#1CFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"/>
              <TextBlock x:Name="DelSlotIcon" Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Grid x:Name="DelCheck" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="DelCheckScale"/></Grid.RenderTransform>
                <Ellipse Fill="#7DF09A" Stroke="Black" StrokeThickness="2"/>
                <Path Data="M5.5,10.5 L8.7,13.6 L14.8,6.8" Stroke="#0F2A17" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Grid>
            </Grid>
            <Canvas Grid.ColumnSpan="3" IsHitTestVisible="False">
              <Border x:Name="DelThumb" Width="30" Height="30" CornerRadius="7" Background="#F2F2F7" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <TransformGroup><ScaleTransform x:Name="DelThumbScale"/><RotateTransform x:Name="DelThumbSpin"/><TranslateTransform x:Name="DelThumbMove"/></TransformGroup>
                </Border.RenderTransform>
                <Grid>
                  <TextBlock x:Name="DelThumbIcon" Text="&#xE8A5;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="#3A3350" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Border CornerRadius="7"><Border.Background><ImageBrush x:Name="DelThumbBrush" Stretch="UniformToFill"/></Border.Background></Border>
                </Grid>
              </Border>
            </Canvas>
          </Grid>

          <!-- ===== Expanded ===== -->
          <Grid x:Name="Expanded" Width="680" Height="232" VerticalAlignment="Top" HorizontalAlignment="Center"
                Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
              <TransformGroup><ScaleTransform x:Name="ExpScale"/><TranslateTransform x:Name="ExpShift"/></TransformGroup>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- mascot column -->
            <Grid Margin="14,8,4,22">
              <local:Mascot x:Name="BigMascot" Width="96" Height="96" VerticalAlignment="Top" Margin="0,22,0,0" Cursor="Hand" ToolTip="Pet me, or drag me out onto your taskbar!"/>
              <StackPanel x:Name="BuddyAway" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,10,0,0">
                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{StaticResource FgFaint}" HorizontalAlignment="Center"/>
                <TextBlock Text="Mochi is out playing on your taskbar" FontSize="11" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,8"/>
                <Button x:Name="CallHomeBtn" Style="{StaticResource Pill}" Content="Call home" HorizontalAlignment="Center" Margin="0"/>
              </StackPanel>
              <TextBlock x:Name="MoodText" VerticalAlignment="Bottom" TextAlignment="Center" FontSize="11"
                         Foreground="{StaticResource FgDim}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Grid Grid.Column="1" Margin="4,0,20,20">
              <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>

              <!-- header -->
              <Grid VerticalAlignment="Center" Margin="0,6,0,0">
                <StackPanel x:Name="Tabs" Orientation="Horizontal">
                  <RadioButton Style="{StaticResource Tab}" Tag="home" Content="&#xE8D6;" ToolTip="Now playing" IsChecked="True"/>
                  <RadioButton Style="{StaticResource Tab}" Tag="shelf" Content="&#xE8B7;" ToolTip="File pocket"/>
                  <RadioButton Style="{StaticResource Tab}" Tag="clip" Content="&#xE77F;" ToolTip="Clipboard history"/>
                  <RadioButton Style="{StaticResource Tab}" Tag="timer" Content="&#xE916;" ToolTip="Focus timer"/>
                  <RadioButton Style="{StaticResource Tab}" Tag="notes" Content="&#xE70B;" ToolTip="Quick notes"/>
                  <RadioButton Style="{StaticResource Tab}" Tag="settings" Content="&#xE713;" ToolTip="Settings"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="ClockText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="BatteryGlyph" FontFamily="{StaticResource Icons}" FontSize="15" Margin="12,0,4,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="BatteryText" FontSize="12" Foreground="{StaticResource FgDim}" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1">
                <!-- ===== Now playing ===== -->
                <Grid x:Name="PanelHome">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border x:Name="ArtBox" Width="124" Height="124" CornerRadius="18" Background="#18FFFFFF" VerticalAlignment="Top" Margin="0,6,0,0" Cursor="Hand" ToolTip="Open the player">
                    <Grid>
                      <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource Icons}" FontSize="38" Foreground="#44FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border CornerRadius="18"><Border.Background><ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/></Border.Background></Border>
                    </Grid>
                  </Border>
                  <Grid Grid.Column="1" Margin="14,6,0,0">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Nothing playing"/>
                    <TextBlock x:Name="ArtistText" Grid.Row="1" FontSize="13" Foreground="{StaticResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" Text="Play something in Spotify"/>
                    <TextBlock x:Name="SourceText" Grid.Row="2" FontSize="10" Foreground="{StaticResource FgFaint}" Margin="0,3,0,0"/>

                    <Grid x:Name="SeekBar" Grid.Row="4" Height="18" Background="#01000000" Cursor="Hand">
                      <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                      <Border x:Name="SeekFill" Height="4" CornerRadius="2" Background="{DynamicResource Accent}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                      <Ellipse x:Name="SeekKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="KnobScale" ScaleX="0.7" ScaleY="0.7"/><TranslateTransform x:Name="KnobShift"/></TransformGroup></Ellipse.RenderTransform>
                      </Ellipse>
                    </Grid>
                    <Grid Grid.Row="5" Margin="0,-1,0,0">
                      <TextBlock x:Name="PosText" FontSize="10.5" Foreground="{StaticResource FgFaint}" Text="0:00"/>
                      <TextBlock x:Name="DurText" FontSize="10.5" Foreground="{StaticResource FgFaint}" HorizontalAlignment="Right" Text="0:00"/>
                    </Grid>
                    <Grid Grid.Row="6" Margin="0,2,0,0">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="13" ToolTip="Shuffle"/>
                        <Button x:Name="PrevBtn" Style="{StaticResource IconButton}" Content="&#xE892;" Margin="2,0"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}" Content="&#xE768;" Margin="4,0"/>
                        <Button x:Name="NextBtn" Style="{StaticResource IconButton}" Content="&#xE893;" Margin="2,0"/>
                        <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="13" ToolTip="Repeat"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Content="&#xE767;" FontSize="13" Width="28" Height="28"/>
                        <Grid x:Name="VolBar" Width="76" Height="18" Background="#01000000" Cursor="Hand" VerticalAlignment="Center">
                          <Border Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center"/>
                          <Border x:Name="VolFill" Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" HorizontalAlignment="Left" Width="30"/>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Grid>

                <!-- ===== File pocket ===== -->
                <Grid x:Name="PanelShelf" Visibility="Collapsed">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid x:Name="ShelfEmpty">
                    <Rectangle RadiusX="16" RadiusY="16" Stroke="#40FFFFFF" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource FgDim}"/>
                      <TextBlock Text="Drop files here" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                      <TextBlock Text="I'll hold them while you switch apps, then drag them back out. Or tap iPhone to send from your phone." FontSize="11" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                  <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
                    <ItemsControl x:Name="ShelfList" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid x:Name="Root" Width="84" Height="116" Margin="0,2,8,0" Background="Transparent" Cursor="Hand">
                            <Border x:Name="TileBg" CornerRadius="14" Background="#14FFFFFF"/>
                            <StackPanel Margin="6,10,6,4">
                              <Image Source="{Binding Thumb}" Width="54" Height="54" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                              <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="30" TextAlignment="Center" Margin="0,6,0,0"/>
                              <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="#80FFFFFF" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button x:Name="Rm" Tag="remove" Style="{StaticResource MiniButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Visibility="Hidden" ToolTip="Remove from pocket"/>
                            <Button x:Name="Rv" Tag="reveal" Style="{StaticResource MiniButton}" Content="&#xE838;" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Visibility="Hidden" ToolTip="Show in folder"/>
                            <Button x:Name="Ph" Tag="phone" Style="{StaticResource MiniButton}" Content="&#xE8EA;" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,4,0" Visibility="Hidden" ToolTip="Send to iPhone"/>
                          </Grid>
                          <DataTemplate.Triggers>
                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                              <Setter TargetName="TileBg" Property="Background" Value="#26FFFFFF"/>
                              <Setter TargetName="Rm" Property="Visibility" Value="Visible"/>
                              <Setter TargetName="Rv" Property="Visibility" Value="Visible"/>
                              <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <Grid Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock x:Name="ShelfCount" FontSize="11" Foreground="{StaticResource FgFaint}" VerticalAlignment="Center" Margin="2,0,0,6"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button x:Name="ShelfPhone" Style="{StaticResource Pill}" ToolTip="Send files from your iPhone over Wi-Fi">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="iPhone"/></StackPanel>
                      </Button>
                      <Button x:Name="ShelfDragAll" Style="{StaticResource Pill}" ToolTip="Drag this to drop every file at once">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Drag all"/></StackPanel>
                      </Button>
                      <Button x:Name="ShelfPaste" Style="{StaticResource Pill}" ToolTip="Add whatever is on the clipboard">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77F;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Paste"/></StackPanel>
                      </Button>
                      <Button x:Name="ShelfSnip" Style="{StaticResource Pill}" ToolTip="Take a screenshot straight into the pocket">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Snip"/></StackPanel>
                      </Button>
                      <Button x:Name="ShelfClear" Style="{StaticResource Pill}" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Clear"/></StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="PhonePanel" Grid.RowSpan="2" Visibility="Collapsed" Background="#F5000000">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border CornerRadius="14" Background="White" Width="152" Height="152" VerticalAlignment="Center">
                      <Image x:Name="PhoneQr" Margin="3" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Send from your iPhone" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock x:Name="PhoneStatus" FontSize="11.5" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      <TextBlock x:Name="PhoneUrl" FontSize="10.5" Foreground="{StaticResource FgFaint}" TextWrapping="Wrap" Margin="0,6,0,10"/>
                      <WrapPanel>
                        <Button x:Name="PhoneSendClip" Style="{StaticResource Pill}" Content="Send clipboard" ToolTip="Send whatever you copied (text, link, files or a screenshot) to your iPhone"/>
                        <Button x:Name="PhoneDone" Style="{StaticResource Pill}" Content="Done"/>
                        <Button x:Name="PhoneNewKey" Style="{StaticResource Pill}" Content="New key" ToolTip="Make a new secret link (old QR codes stop working)"/>
                        <Button x:Name="PhoneOff" Style="{StaticResource Pill}" Content="Turn off"/>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                  <Grid x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#E6000000">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DropPhoneCol" Width="0"/></Grid.ColumnDefinitions>
                    <Grid x:Name="DropZonePhone" Grid.Column="1" Margin="10,0,0,0" Background="#01000000">
                      <Rectangle x:Name="DropPhoneRect" RadiusX="16" RadiusY="16" Stroke="#55FFFFFF" StrokeThickness="2" StrokeDashArray="5 3"/>
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="26" HorizontalAlignment="Center" Foreground="{StaticResource FgDim}"/>
                        <TextBlock Text="Send to iPhone" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="Mochi will deliver it" FontSize="11" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <Rectangle x:Name="DropPocketRect" RadiusX="16" RadiusY="16" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeDashArray="5 3"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="Feed me!" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                      <TextBlock x:Name="DropHint" Text="Let go to drop it in the pocket" FontSize="11" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                </Grid>

                <!-- ===== Clipboard ===== -->
                <Grid x:Name="PanelClip" Visibility="Collapsed">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="0,0,0,6">
                    <TextBlock Text="Clipboard history" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock Text="click a row to copy it again" FontSize="10.5" Foreground="{StaticResource FgFaint}" VerticalAlignment="Center" Margin="0,0,10,6"/>
                      <Button x:Name="ClipClear" Style="{StaticResource Pill}" Content="Clear" Margin="0,0,0,6"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="ClipEmpty" Grid.Row="1" FontSize="12" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                             Text="Copy some text and it shows up here. Kept in memory only, never saved to disk."/>
                  <ScrollViewer x:Name="ClipScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="ClipList" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid x:Name="Root" Height="30" Margin="0,0,8,4" Background="Transparent" Cursor="Hand">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="Bg" Grid.ColumnSpan="5" CornerRadius="9" Background="#12FFFFFF"/>
                            <TextBlock Text="{Binding Preview}" Margin="10,0,6,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Age}" FontSize="10" Foreground="{StaticResource FgFaint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Tag="phone" Style="{StaticResource MiniButton}" Content="&#xE8EA;" Margin="0,0,4,0" ToolTip="Send to iPhone"/>
                            <Button Grid.Column="3" Tag="pin" Style="{StaticResource MiniButton}" Content="{Binding PinGlyph}" Margin="0,0,4,0" Opacity="{Binding PinOpacity}" ToolTip="Pin"/>
                            <Button Grid.Column="4" Tag="delete" Style="{StaticResource MiniButton}" Content="&#xE711;" Margin="0,0,5,0" ToolTip="Forget"/>
                          </Grid>
                          <DataTemplate.Triggers>
                            <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                              <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>

                <!-- ===== Timer ===== -->
                <Grid x:Name="PanelTimer" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid Width="140" Height="140" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <Ellipse Stroke="#1FFFFFFF" StrokeThickness="7"/>
                    <Ellipse x:Name="TimerRing" Stroke="{DynamicResource Accent}" StrokeThickness="7" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="TimerBig" Text="25:00" FontSize="31" FontWeight="Light" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TimerLabel" Text="ready" FontSize="11" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Column="1" Margin="4,4,0,0">
                    <TextBlock Text="Quick start" FontSize="11" Foreground="{StaticResource FgFaint}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="TimerPresets">
                      <Button Style="{StaticResource Pill}" Tag="1" Content="1m"/>
                      <Button Style="{StaticResource Pill}" Tag="5" Content="5m"/>
                      <Button Style="{StaticResource Pill}" Tag="10" Content="10m"/>
                      <Button Style="{StaticResource Pill}" Tag="15" Content="15m"/>
                      <Button Style="{StaticResource Pill}" Tag="25" Content="25m focus"/>
                      <Button Style="{StaticResource Pill}" Tag="45" Content="45m"/>
                      <Button Style="{StaticResource Pill}" Tag="-1" Content="−1"/>
                      <Button Style="{StaticResource Pill}" Tag="+1" Content="+1"/>
                      <Button Style="{StaticResource Pill}" Tag="+5" Content="+5"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button x:Name="TimerStart" Style="{StaticResource Pill}" Background="{DynamicResource Accent}" Foreground="#111111" Padding="18,7" FontSize="12.5" FontWeight="SemiBold" Content="Start"/>
                      <Button x:Name="TimerReset" Style="{StaticResource Pill}" Padding="16,7" FontSize="12.5" Content="Reset"/>
                    </StackPanel>
                    <TextBlock x:Name="TimerHint" FontSize="10.5" Foreground="{StaticResource FgFaint}" Margin="0,4,0,0" Text="The notch shows a countdown while you work."/>
                  </StackPanel>
                </Grid>

                <!-- ===== Notes ===== -->
                <Grid x:Name="PanelNotes" Visibility="Collapsed">
                  <Border CornerRadius="14" Background="#10FFFFFF"/>
                  <TextBlock x:Name="NotesHint" Text="Jot something down… it saves automatically." Margin="11,7" FontSize="13" Foreground="{StaticResource FgFaint}" IsHitTestVisible="False"/>
                  <TextBox x:Name="NotesBox" Style="{StaticResource NotesBox}"/>
                </Grid>

                <!-- ===== Settings ===== -->
                <Grid x:Name="PanelSettings" Visibility="Collapsed">
                  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <UniformGrid x:Name="SettingsGrid" Columns="2" Margin="0,-4,8,0"/>
                  </ScrollViewer>
                  <Grid Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock FontSize="10.5" Foreground="{StaticResource FgFaint}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,90,0"
                               Text="Ctrl+Alt+Space · scroll = volume · middle-click = play/pause"/>
                    <Button x:Name="QuitBtn" Style="{StaticResource Pill}" Content="Quit Notch" HorizontalAlignment="Right" Margin="0"/>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </local:NotchBody>
    </Grid>
  </Border>
</Grid>
